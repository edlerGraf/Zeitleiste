<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zeitleiste — Lifetimes</title>
<style>
  :root{
    --ink:#111;
    --paper:#fff;
    --faint:#e6e6e6;
    --mid:#999;
    --bar-h:22px;
    --row-h:30px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{background:var(--paper);color:var(--ink);
    font-family:Georgia,'Times New Roman',serif;font-size:15px;
    height:100%;overflow:hidden}
  #chrome{padding:0}
  header{padding:18px 32px 6px}
  h1{font-size:22px;font-weight:normal;letter-spacing:.02em}
  h1 .sub{color:var(--mid);font-size:14px;margin-left:10px}
  /* ---------- controls ---------- */
  #controls{
    padding:12px 32px 12px;border-bottom:1px solid var(--ink);
    display:flex;flex-wrap:wrap;gap:18px;align-items:flex-end;
    font-family:Helvetica,Arial,sans-serif;font-size:12.5px}
  .ctl-group{display:flex;flex-direction:column;gap:6px}
  .ctl-label{text-transform:uppercase;letter-spacing:.08em;font-size:10px;color:var(--mid)}
  .cats{display:flex;flex-wrap:wrap;gap:4px}
  .cat-btn{
    border:1px solid var(--ink);background:var(--paper);color:var(--ink);
    padding:4px 10px;cursor:pointer;font:inherit;user-select:none}
  .cat-btn.on{background:var(--ink);color:var(--paper)}
  .cat-btn:focus-visible,select:focus-visible,.preset:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
  select{
    border:1px solid var(--ink);background:var(--paper);color:var(--ink);
    padding:4px 6px;font:inherit;max-width:230px}
  .preset{
    border:1px solid var(--ink);background:var(--paper);padding:4px 10px;
    cursor:pointer;font:inherit}
  .preset.on{background:var(--ink);color:var(--paper)}
  #count{color:var(--mid);margin-left:auto;align-self:center}
  /* ---------- scrolling timeline ---------- */
  /* #scroller owns BOTH scrollbars. The axis is sticky to its top edge:
     locked vertically, travels horizontally with the rows. */
  #scroller{overflow:auto;position:relative}
  #inner{position:relative;min-width:100%}
  #axis{
    position:sticky;top:0;z-index:5;height:34px;background:var(--paper);
    border-bottom:1px solid var(--faint);
    font-family:Helvetica,Arial,sans-serif;font-size:10.5px;color:var(--mid)}
  .tick{position:absolute;top:0;height:100%;border-left:1px solid var(--faint)}
  .tick span{position:absolute;top:8px;left:4px;white-space:nowrap}
  .tick.major{border-left-color:var(--mid)}
  #rows{position:relative;padding-bottom:40px}
  .gridline{position:absolute;top:0;bottom:0;border-left:1px solid var(--faint);z-index:0}
  .gridline.major{border-left-color:#ccc}
  .row{position:relative;height:var(--row-h);z-index:1}
  .row:hover{background:#f5f5f5}
  .bar{
    position:absolute;top:calc((var(--row-h) - var(--bar-h))/2);height:var(--bar-h);
    background:var(--ink);display:flex;align-items:center;white-space:nowrap}
  .bar.living{border-right:3px double var(--paper)}
  .name{
    color:var(--paper);font-size:12px;line-height:1;white-space:nowrap;
    pointer-events:none;padding:0 8px}
  .name .yrs{color:#bbb;font-size:10.5px;margin-left:6px;font-family:Helvetica,Arial,sans-serif}
  /* ref-person highlight in overlap mode */
  .row.ref .bar{outline:1.5px solid var(--ink);outline-offset:2.5px}
  /* ---------- broad overview (era) mode ---------- */
  /* vertical order: dot → emblem text → era bar */
  #eras{position:relative;height:150px;margin-top:26px}
  .dot{
    position:absolute;top:4px;width:12px;height:12px;border-radius:50%;
    background:var(--ink);transform:translateX(-50%);z-index:2}
  .emblem{
    position:absolute;top:22px;transform:translateX(-50%);text-align:center;
    font-size:12.5px;white-space:nowrap;z-index:2}
  .emblem .yrs2{display:block;color:var(--mid);font-size:10.5px;
    font-family:Helvetica,Arial,sans-serif;margin-top:2px}
  .era{
    position:absolute;top:68px;height:46px;background:#d9d9d9;
    border-left:1px solid var(--paper);display:flex;align-items:center;justify-content:center}
  .era .era-name{
    font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:.05em;
    color:#444;text-transform:uppercase;white-space:nowrap;overflow:hidden;
    text-overflow:ellipsis;padding:0 6px;text-align:center}
  .era .era-name .range{display:block;font-size:10px;letter-spacing:0;
    text-transform:none;color:#777;margin-top:2px}
  /* arrow terminal: era continues beyond the left edge into deep time */
  .era.arrow{border-left:none;margin-left:14px}
  .era.arrow::before{
    content:"";position:absolute;left:-14px;top:0;
    border-top:23px solid transparent;border-bottom:23px solid transparent;
    border-right:14px solid #d9d9d9}
  /* ---------- tooltip ---------- */
  #tip{
    position:fixed;z-index:20;background:var(--ink);color:var(--paper);
    font-family:Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;
    padding:8px 11px;max-width:260px;pointer-events:none;display:none}
  #tip b{font-size:13px}
  #tip .dim{color:#bbb}
  #empty{padding:60px 0;color:var(--mid);text-align:center;font-style:italic;display:none}
  @media (max-width:700px){
    header,#controls{padding-left:14px;padding-right:14px}
  }
</style>
</head>
<body>
<div id="chrome">
<header>
  <h1>Zeitleiste<span class="sub">lifetimes, filterable — prototype (monochrome)</span></h1>
</header>

<div id="controls">
  <div class="ctl-group">
    <span class="ctl-label">Preset</span>
    <div class="cats">
      <button class="preset on" id="btn-gnh">Goethe · Nietzsche · Hesse</button>
      <button class="preset" id="btn-all">All people</button>
      <button class="preset" id="btn-ov">Broad overview</button>
    </div>
  </div>
  <div class="ctl-group">
    <span class="ctl-label">Labels</span>
    <div class="cats" id="catBtns"></div>
  </div>
  <div class="ctl-group">
    <span class="ctl-label">Lived at the same time as</span>
    <select id="overlapSel"><option value="">— anyone —</option></select>
  </div>
  <span id="count"></span>
</div>
</div><!-- /chrome -->

<div id="scroller">
  <div id="inner">
    <div id="axis"></div>
    <div id="rows"></div>
    <div id="empty">No one matches the current filters.</div>
  </div>
</div>

<div id="tip"></div>

<script>
/* ============ DATA ============ */
/* d: 0 = living. Categories: LPT, MUS, POL, SCI, ART, ARC */
const CAT_NAMES = {
  LPT:"Literature, Philosophy, Theory", MUS:"Music", POL:"Politics",
  SCI:"Science and Technology", ART:"Visual Arts", ARC:"Architects"
