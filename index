 ["Imre Steindl",1839,1902,["ARC"],"Pest, Budapest"],
 ["Otto Brückwald",1841,1917,["ARC"],"Leipzig, Bayreuth"],
 ["Paul Wallot",1841,1912,["ARC"],"Oppenheim, Berlin"],
